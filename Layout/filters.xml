<Screen>
  <Layout>
    <Title height="1">Ticket filters</Title>
    <Separator />
    <Layout direction="horizontal" height="1*">
      <Layout width="30">
        <List id="projects" title="Projects" height="5" />
        <Button label="Select project" action="MAJIRA\App\Controller::selectProject" />
        <Button label="Reload projects" action="MAJIRA\App\Controller::reloadProjects" />
        <Separator />
        <List id="boards" title="Boards" height="5" />
        <Button label="Select board" action="MAJIRA\App\Controller::selectBoard" />
        <Button label="Reload boards" action="MAJIRA\App\Controller::reloadBoards" />
        <Separator />
        <List id="sprints" title="Sprints" height="5" />
        <Button label="Select sprint" action="MAJIRA\App\Controller::selectSprint" />
        <Button label="Reload sprints" action="MAJIRA\App\Controller::reloadSprints" />
        <Empty height="1*" />
      </Layout>
      <Separator />
      <Layout width="32">
        <Input id="search" label="Search text" />
        <Input id="updated" label="Updated since (YYYY-MM-DD)" />
        <Input id="created" label="Created since (YYYY-MM-DD)" />
        <Input id="custom-name" label="Filter name" />
        <Button label="Save current JQL" action="MAJIRA\App\Controller::saveCustomFilter" />
        <Button label="Clear filters" action="MAJIRA\App\Controller::clearFilters" />
        <Button label="Load filter options" action="MAJIRA\App\Controller::loadFilterOptions" />
        <Empty height="1*" />
      </Layout>
      <Separator />
      <Layout width="20">
        <List id="filter-groups" title="Filter" height="1*">
          <Item value="status">Status</Item>
          <Item value="type">Type</Item>
          <Item value="priority">Priority</Item>
          <Item value="assignee">Assignee</Item>
          <Event type="change" action="MAJIRA\App\Controller::filterGroupChanged" />
        </List>
      </Layout>
      <Separator />
      <Layout width="1*">
        <List id="filter-options" title="Values (Space to toggle)" multiple="true" height="1*" />
        <Button label="Keep selected values" action="MAJIRA\App\Controller::saveFilterGroup" />
      </Layout>
      <Separator />
      <Layout width="24">
        <List id="custom-filters" title="Saved JQL" height="1*" />
        <Button label="Use saved filter" action="MAJIRA\App\Controller::useCustomFilter" />
        <Button label="Delete saved filter" action="MAJIRA\App\Controller::deleteCustomFilter" />
      </Layout>
    </Layout>
    <Separator />
    <Button label="Save and apply named filter" action="MAJIRA\App\Controller::applyFilters" />
    <StatusBar id="status" height="1" />
  </Layout>
</Screen>
