<Screen>
  <Layout>
    <Title id="create-project" height="1">New ticket</Title>
    <Separator />
    <Layout direction="horizontal" height="1*">
      <Layout width="28">
        <List id="create-types" title="Issue type" height="1*" />
      </Layout>
      <Separator />
      <Layout width="1*">
        <Input id="create-summary" label="Summary" />
        <TextEditor id="create-description" label="Description" textWrap="true" height="1*" />
        <Layout direction="horizontal" height="1">
          <Button label="Create ticket" hotkey="c" action="MAJIRA\App\Controller::createTicket" />
          <Button label="Cancel" hotkey="escape" action="MAJIRA\App\Controller::showList" />
          <Empty width="1*" />
        </Layout>
      </Layout>
    </Layout>
    <Separator />
    <StatusBar id="status" height="1" />
  </Layout>
</Screen>
