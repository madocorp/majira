<Screen>
  <Event type="keyDown" key="escape" action="MAJIRA\App\Controller::cancelFieldSettings" />
  <Layout>
    <Layout direction="horizontal" height="1*">
      <Layout id="settings-left" width="48">
        <Image id="settings-logo" src="../Assets/logo.png" fit="contain" interactive="false" navigate="true" />
        <Separator />
        <Layout id="settings-body" height="1*">
          <Input id="jira-site" label="Jira site (https://example.atlassian.net)" />
          <Input id="jira-email" label="Email" />
          <Input id="jira-token" label="API token" password="true" />
          <Button id="settings-connect" label="Connect" hotkey="c" action="MAJIRA\App\Controller::connect" />
          <Empty height="1*" />
          <Button id="settings-fields" label="Fields" hotkey="f" action="MAJIRA\App\Controller::openFieldSettings" />
          <Button id="settings-clear" label="Clear cache" hotkey="r" action="MAJIRA\App\Controller::clearCaches" />
          <Button id="settings-quit" label="Quit" hotkey="q" action="MAJIRA\App\Controller::quit" />
        </Layout>
      </Layout>
      <List id="settings-fields-list" overwrite="#settings-left" title="Fields for List and Ticket" multiple="true" filterable="false" searchable="true" reorderable="true" tip="Space moves a field between selected and available groups; Shift+Up/Down reorders; Return saves; Esc cancels." width="48"><Event type="change" action="MAJIRA\App\Controller::fieldSelectionChanged" /><Event type="reorder" action="MAJIRA\App\Controller::fieldOrderChanged" /><Event type="keyDown" key="enter" action="MAJIRA\App\Controller::saveFieldSettings" /><Event type="keyDown" key="escape" action="MAJIRA\App\Controller::cancelFieldSettings" /><Event type="deactivate" action="MAJIRA\App\Controller::cancelFieldSettings" /></List>
      <Separator />
      <Layout id="settings-right" width="1*">
        <Text id="settings-about" title="About MaJira" height="6">MaJira is a tile based Jira Cloud browser built with SPTK. Browse cached tickets, search with filters or JQL, inspect a board, and open ticket details. Jira requests are shown in the status bar.</Text>
        <Separator />
        <Text id="settings-unlicense" title="Unlicense" height="1*" />
      </Layout>
    </Layout>
    <Separator />
    <StatusBar id="status" height="1" />
  </Layout>
</Screen>
